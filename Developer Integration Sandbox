    <!-- JAVASCRIPT LOGIC AND LIFE-CYCLE SIMULATION ENGINE -->
    <script>
        // Core Category Map Databases
        const GLOBAL_PARENTS = {
            PHYSICAL: {
                name: "Physical Retail Goods",
                tr_delivery: 15,
                tr_inspection: 20,
                tr_rejection: 12
            },
            DIGITAL: {
                name: "Professional Digital Services",
                tr_delivery: 30,
                tr_inspection: 30,
                tr_rejection: 20
            }
        };

        // State Machine states enum
        const LIFECYCLE_STATES = {
            UNINITIALIZED: 'UNINITIALIZED',
            INITIALIZATION: 'INITIALIZATION',
            PRE_FULFILLMENT: 'PRE-FULFILLMENT',
            POST_FULFILLMENT: 'POST-FULFILLMENT',
            REJECTION_RECONCILIATION: 'REJECTION-RECONCILIATION',
            DISPUTE_TRIAGE: 'DISPUTE-TRIAGE',
            AUTO_CANCELLED: 'AUTO-CANCELLED',
            SETTLED: 'SETTLED'
        };

        // UI Tabs Routing Controls
        const tabs = {
            map: { btn: document.getElementById('tab-btn-map'), sec: document.getElementById('tab-section-map') },
            checkout: { btn: document.getElementById('tab-btn-checkout'), sec: document.getElementById('tab-section-checkout') },
            sandbox: { btn: document.getElementById('tab-btn-sandbox'), sec: document.getElementById('tab-section-sandbox') },
            docs: { btn: document.getElementById('tab-btn-docs'), sec: document.getElementById('tab-section-docs') }
        };

        function selectTab(targetTabKey) {
            Object.keys(tabs).forEach(key => {
                if (key === targetTabKey) {
                    tabs[key].btn.classList.add('border-brandBlue', 'text-white');
                    tabs[key].btn.classList.remove('border-transparent', 'text-gray-400');
                    tabs[key].sec.classList.remove('hidden');
                } else {
                    tabs[key].btn.classList.remove('border-brandBlue', 'text-white');
                    tabs[key].btn.classList.add('border-transparent', 'text-gray-400');
                    tabs[key].sec.classList.add('hidden');
                }
            });
        }

        tabs.map.btn.addEventListener('click', () => selectTab('map'));
        tabs.checkout.btn.addEventListener('click', () => selectTab('checkout'));
        tabs.sandbox.btn.addEventListener('click', () => selectTab('sandbox'));
        tabs.docs.btn.addEventListener('click', () => selectTab('docs'));

        // Toast Helper
        function triggerToast(title, message, icon = '⚡', borderClass = 'border-brandBlue') {
            const toast = document.getElementById('toast-notification');
            document.getElementById('toast-title').innerText = title;
            document.getElementById('toast-message').innerText = message;
            document.getElementById('toast-icon').innerText = icon;
            toast.className = `fixed bottom-5 right-5 z-50 p-4 rounded-xl shadow-2xl flex items-start gap-3 max-w-sm pointer-events-auto bg-slate-900 border ${borderClass} transition-all duration-300 transform translate-y-0 opacity-100`;
            
            setTimeout(() => {
                toast.className = `fixed bottom-5 right-5 z-50 p-4 rounded-xl shadow-2xl flex items-start gap-3 max-w-sm pointer-events-none bg-slate-900 border ${borderClass} transition-all duration-300 transform translate-y-20 opacity-0`;
            }, 3000);
        }

        // CATEGORY RESOLVER LOGIC (Heuristic String Distance lookup)
        let mappedConfigResult = { ...GLOBAL_PARENTS.PHYSICAL, resolvedLabel: "Physical Retail Goods", strategy: "STANDARDISED_MATCH" };

        const categorySelector = document.getElementById('category-selector-api');
        const resolveButton = document.getElementById('btn-resolve-mapping');

        resolveButton.addEventListener('click', () => {
            const rawValue = categorySelector.value;
            
            // Heuristic Distance Evaluator
            if (rawValue.includes("Physical")) {
                mappedConfigResult = {
                    ...GLOBAL_PARENTS.PHYSICAL,
                    resolvedLabel: "Physical Retail Goods",
                    strategy: "DIRECT_REGISTRATION_MATCH"
                };
            } else if (rawValue.includes("Digital") || rawValue.includes("Python")) {
                mappedConfigResult = {
                    ...GLOBAL_PARENTS.DIGITAL,
                    resolvedLabel: rawValue.includes("Python") ? "CUSTOM_MAPPED_DIGITAL_SERVICES" : "Professional Digital Services",
                    strategy: rawValue.includes("Python") ? "HEURISTIC_CONFIDENCE_MATCH_88%" : "DIRECT_REGISTRATION_MATCH"
                };
            } else if (rawValue.includes("Antiques")) {
                // High value item defaults to Physical parent but maps custom
                mappedConfigResult = {
                    ...GLOBAL_PARENTS.PHYSICAL,
                    resolvedLabel: "CUSTOM_MAPPED_PHYSICAL_ANTIQUES",
                    strategy: "HEURISTIC_CONFIDENCE_MATCH_74%"
                };
            } else {
                // Fallback triggered
                mappedConfigResult = {
                    ...GLOBAL_PARENTS.PHYSICAL,
                    resolvedLabel: "FALLBACK_CAT_PHYSICAL",
                    strategy: "FALLBACK_ANCESTOR_RESOLVER"
                };
            }

            // Update UI elements in resolution panel
            document.getElementById('mapping-badge-status').innerText = "MAPPED_CONFIRMED";
            document.getElementById('mapping-badge-status').className = "px-2 py-0.5 rounded text-[9px] font-mono bg-brandEmerald/20 text-brandEmerald border border-brandEmerald/30";
            
            document.getElementById('map-out-parent').innerText = mappedConfigResult.resolvedLabel;
            document.getElementById('map-out-strategy').innerText = mappedConfigResult.strategy;
            document.getElementById('map-out-timers').innerText = `DEL: ${mappedConfigResult.tr_delivery}s | INSP: ${mappedConfigResult.tr_inspection}s`;
            
            document.getElementById('map-out-text').innerHTML = `<strong>Success:</strong> API dynamically parsed string <code>"${rawValue}"</code> and assigned Parent bounds. Routing will execute correctly inside client sandbox checkout modules.`;

            // Sync checkout category text input box
            document.getElementById('checkout-category-input').value = mappedConfigResult.resolvedLabel;

            triggerToast("Mapping Resolved", `Routed Category string to: ${mappedConfigResult.resolvedLabel}`, '🏷️', 'border-brandEmerald');
        });

        // Step transition helper
        document.getElementById('btn-proceed-to-checkout').addEventListener('click', () => {
            selectTab('checkout');
            triggerToast("Step 2 Initiated", "Category configuration mapping imported into NexaMarket Checkout.", '🛒');
        });

        // API INITIALIZATION PAYLOAD GENERATOR
        const dealNameInput = document.getElementById('checkout-deal-name');
        const dealAmountInput = document.getElementById('checkout-amount');
        const payoutDelaySelect = document.getElementById('checkout-payment-delay');
        const requestJsonPre = document.getElementById('api-request-json');

        function updateRequestPayloadJson() {
            const apiPayload = {
                partner_id: "part_nexamarket_26",
                category_string: mappedConfigResult.resolvedLabel,
                transaction_value: parseFloat(dealAmountInput.value) || 2500.00,
                contract_name: dealNameInput.value,
                recipient_id: "merch_node_99a1",
                seller_configs: {
                    tr_payment_hold_seconds: parseInt(payoutDelaySelect.value)
                }
            };
            requestJsonPre.innerText = JSON.stringify(apiPayload, null, 2);
        }

        dealNameInput.addEventListener('input', updateRequestPayloadJson);
        dealAmountInput.addEventListener('input', updateRequestPayloadJson);
        payoutDelaySelect.addEventListener('change', updateRequestPayloadJson);
        document.getElementById('btn-back-to-mapping').addEventListener('click', () => selectTab('map'));

        // ESCROW ENGINE SIMULATION STATES ENGINE
        const logConsole = document.getElementById('sandbox-log-console');
        function addSandboxLog(message, type = 'system') {
            const timestamp = new Date().toISOString().split('T')[1].slice(0, 8);
            let colorClass = 'text-brandBlue';
            let icon = '⚙️';
            
            if (type === 'api') { colorClass = 'text-brandBlue'; icon = '🔌'; }
            if (type === 'error') { colorClass = 'text-brandRose'; icon = '⚠️'; }
            if (type === 'success') { colorClass = 'text-brandEmerald'; icon = '✅'; }
            if (type === 'timer') { colorClass = 'text-brandAmber'; icon = '⏱️'; }
            if (type === 'reconcile') { colorClass = 'text-brandViolet'; icon = '🔄'; }

            const logItem = document.createElement('div');
            logItem.className = `flex items-start gap-1.5 leading-relaxed py-0.5 ${colorClass}`;
            logItem.innerHTML = `<span class="text-slate-600 shrink-0 font-semibold">[${timestamp}]</span> <span>${icon} ${message}</span>`;
            
            logConsole.appendChild(logItem);
            logConsole.scrollTop = logConsole.scrollHeight;
        }

        // State machine variables
        let currentSandboxState = LIFECYCLE_STATES.UNINITIALIZED;
        let activeSandboxTimer = null;
        let sandboxTimeLeft = 0;
        let categoryAssignedName = "Physical Retail Goods";
        let sandboxTargetAmt = 2500;
        let sandboxTargetName = "Enterprise Database Server Node V10";
        let sandboxPaymentDelay = 5;
        let extensionsLoggedCount = 0;

        // Visual nodes mapping
        const stateNodes = {
            [LIFECYCLE_STATES.INITIALIZATION]: document.getElementById('scen-state-01'),
            [LIFECYCLE_STATES.PRE_FULFILLMENT]: document.getElementById('scen-state-02'),
            [LIFECYCLE_STATES.POST_FULFILLMENT]: document.getElementById('scen-state-03'),
            [LIFECYCLE_STATES.REJECTION_RECONCILIATION]: document.getElementById('scen-state-04'),
            [LIFECYCLE_STATES.DISPUTE_TRIAGE]: document.getElementById('scen-state-05'),
            [LIFECYCLE_STATES.AUTO_CANCELLED]: document.getElementById('scen-state-06'),
            [LIFECYCLE_STATES.SETTLED]: document.getElementById('scen-state-07')
        };

        const eventButtons = {
            deposit: document.getElementById('scen-api-deposit'),
            courier: document.getElementById('scen-api-courier'),
            timeout: document.getElementById('scen-api-timeout'),
            approve: document.getElementById('scen-api-approve'),
            reject: document.getElementById('scen-api-reject'),
            recAccept: document.getElementById('scen-api-rec-accept'),
            recExtend: document.getElementById('scen-api-rec-extend'),
            recEscalate: document.getElementById('scen-api-rec-escalate'),
            disputeResolve: document.getElementById('scen-api-dispute-resolve')
        };

        const timerBadges = {
            delivery: document.getElementById('badge-scen-delivery'),
            inspection: document.getElementById('badge-scen-inspection'),
            rejection: document.getElementById('badge-scen-rejection')
        };

        const countdowns = {
            delivery: document.getElementById('timer-scen-delivery'),
            inspection: document.getElementById('timer-scen-inspection'),
            rejection: document.getElementById('timer-scen-rejection'),
            payment: document.getElementById('timer-scen-payment')
        };

        // STATE RE-RENDER CONTROLLERS
        function updateSandboxState(targetState, triggerActionName) {
            currentSandboxState = targetState;

            // Log details in outputs
            document.getElementById('simulation-state-tag').innerText = currentSandboxState;
            document.getElementById('current-sandbox-target').innerText = sandboxTargetName;
            document.getElementById('last-sandbox-webhook').innerText = triggerActionName;

            // Clear styling on all card nodes
            Object.values(stateNodes).forEach(el => {
                el.classList.remove('border-brandBlue', 'border-brandAmber', 'border-brandViolet', 'border-brandEmerald', 'border-brandRose', 'bg-slate-900/40');
                el.style.transform = 'scale(1)';
            });

            // Highlight new active card
            const activeCard = stateNodes[currentSandboxState];
            if (activeCard) {
                activeCard.style.transform = 'scale(1.02)';
                if (currentSandboxState === LIFECYCLE_STATES.INITIALIZATION) {
                    activeCard.classList.add('border-brandBlue', 'bg-slate-900/40');
                } else if (currentSandboxState === LIFECYCLE_STATES.PRE_FULFILLMENT) {
                    activeCard.classList.add('border-brandAmber', 'bg-slate-900/40');
                } else if (currentSandboxState === LIFECYCLE_STATES.POST_FULFILLMENT) {
                    activeCard.classList.add('border-brandBlue', 'bg-slate-900/40');
                } else if (currentSandboxState === LIFECYCLE_STATES.REJECTION_RECONCILIATION) {
                    activeCard.classList.add('border-brandViolet', 'bg-slate-900/40');
                } else if (currentSandboxState === LIFECYCLE_STATES.DISPUTE_TRIAGE) {
                    activeCard.classList.add('border-brandRose', 'bg-slate-900/40');
                } else if (currentSandboxState === LIFECYCLE_STATES.AUTO_CANCELLED) {
                    activeCard.classList.add('border-brandRose', 'bg-slate-900/40');
                } else if (currentSandboxState === LIFECYCLE_STATES.SETTLED) {
                    if (triggerActionName === 'PAYMENT_COOLING_ACTIVE') {
                        activeCard.classList.add('border-brandAmber', 'bg-slate-900/40');
                    } else {
                        activeCard.classList.add('border-brandEmerald', 'bg-slate-900/40');
                    }
                }
            }

            // Adjust interactive button permissions
            Object.values(eventButtons).forEach(btn => {
                btn.disabled = true;
                btn.classList.add('opacity-50', 'cursor-not-allowed');
            });

            // Dynamic text defaults
            document.getElementById('lbl-scen-approve').innerText = "Buyer Approves Release";
            document.getElementById('desc-scen-approve').innerText = "Bypasses inspection constraints.";
            document.getElementById('lbl-scen-reject').innerText = "Buyer Rejects Delivery";
            document.getElementById('desc-scen-reject').innerText = "Triggers TR_REJECTION window.";

            if (currentSandboxState === LIFECYCLE_STATES.INITIALIZATION) {
                eventButtons.deposit.disabled = false;
                eventButtons.deposit.classList.remove('opacity-50', 'cursor-not-allowed');
            } else if (currentSandboxState === LIFECYCLE_STATES.PRE_FULFILLMENT) {
                eventButtons.courier.disabled = false;
                eventButtons.courier.classList.remove('opacity-50', 'cursor-not-allowed');
                eventButtons.timeout.disabled = false;
                eventButtons.timeout.classList.remove('opacity-50', 'cursor-not-allowed');
            } else if (currentSandboxState === LIFECYCLE_STATES.POST_FULFILLMENT) {
                eventButtons.approve.disabled = false;
                eventButtons.approve.classList.remove('opacity-50', 'cursor-not-allowed');
                eventButtons.reject.disabled = false;
                eventButtons.reject.classList.remove('opacity-50', 'cursor-not-allowed');
            } else if (currentSandboxState === LIFECYCLE_STATES.REJECTION_RECONCILIATION) {
                eventButtons.recAccept.disabled = false;
                eventButtons.recAccept.classList.remove('opacity-50', 'cursor-not-allowed');
                eventButtons.recEscalate.disabled = false;
                eventButtons.recEscalate.classList.remove('opacity-50', 'cursor-not-allowed');
                
                if (extensionsLoggedCount < 2) {
                    eventButtons.recExtend.disabled = false;
                    eventButtons.recExtend.classList.remove('opacity-50', 'cursor-not-allowed');
                    document.getElementById('lbl-scen-extend').innerText = "Extend Reconcile Limit";
                } else {
                    document.getElementById('lbl-scen-extend').innerText = "Max Extensions Used";
                }
            } else if (currentSandboxState === LIFECYCLE_STATES.DISPUTE_TRIAGE) {
                eventButtons.disputeResolve.disabled = false;
                eventButtons.disputeResolve.classList.remove('opacity-50', 'cursor-not-allowed');
            } else if (currentSandboxState === LIFECYCLE_STATES.SETTLED && triggerActionName === 'PAYMENT_COOLING_ACTIVE') {
                // Allows direct approval overrides or early dispute intercepts
                eventButtons.approve.disabled = false;
                eventButtons.approve.classList.remove('opacity-50', 'cursor-not-allowed');
                document.getElementById('lbl-scen-approve').innerText = "Force Direct Release";
                document.getElementById('desc-scen-approve').innerText = "Bypasses cooling countdown instantly.";

                eventButtons.reject.disabled = false;
                eventButtons.reject.classList.remove('opacity-50', 'cursor-not-allowed');
                document.getElementById('lbl-scen-reject').innerText = "Intercept & Dispute";
                document.getElementById('desc-scen-reject').innerText = "Freeze pending ledger during cooling.";
            }

            addSandboxLog(`State transitioned: [${currentSandboxState}] (Trigger: ${triggerActionName})`, 'success');
            updateOutboundPayloadJson();
        }

        // Copy Callback Handler
        document.getElementById('btn-copy-sandbox-payload').addEventListener('click', () => {
            const code = document.getElementById('sandbox-payload-content').innerText;
            const el = document.createElement('textarea');
            el.value = code;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            triggerToast("Payload Copied", "Simulated JSON output copied to clipboard.", "📋");
        });

        // Dynamic State Machine callback JSON generator
        function updateOutboundPayloadJson() {
            const outBox = document.getElementById('sandbox-payload-content');
            let resolutionType = "MAPPED_OUTFLOW";
            
            if (currentSandboxState === LIFECYCLE_STATES.AUTO_CANCELLED) resolutionType = "REVERT_PAYBACK_CLEAR";
            if (currentSandboxState === LIFECYCLE_STATES.SETTLED) resolutionType = "ESCROW_WALLET_CREDITED";

            const data = {
                timestamp_epoch: Date.now(),
                state_transition_code: currentSandboxState,
                contract_ref: "tx_nexa_78a1",
                amount_fiat: sandboxTargetAmt,
                parent_category_applied: categoryAssignedName,
                routing_configurations: {
                    ledger_destination: "PROPRIETARY_ESCROW_WALLET",
                    outflow_target: "merch_node_99a1",
                    lien_unlocked: (currentSandboxState === LIFECYCLE_STATES.SETTLED && sandboxTimeLeft <= 0)
                },
                metadata: {
                    dispute_extension_events: extensionsLoggedCount,
                    state_checksum_hash: "sha256_" + Math.floor(Math.random() * 900000).toString(16)
                },
                api_callback_resolution: resolutionType
            };
            outBox.innerText = JSON.stringify(data, null, 2);
        }

        // INTERVAL AND TIMING CLEARERS
        function clearSandboxTimers() {
            if (activeSandboxTimer) {
                clearInterval(activeSandboxTimer);
                activeSandboxTimer = null;
            }
            sandboxTimeLeft = 0;
            countdowns.delivery.innerText = '-';
            countdowns.inspection.innerText = '-';
            countdowns.rejection.innerText = '-';
            countdowns.payment.innerText = '-';
            countdowns.payment.classList.add('hidden');
            
            Object.values(timerBadges).forEach(el => el.classList.add('hidden'));
        }

        // ACTION TRIGER: INITIALIZE CONTRACT
        document.getElementById('btn-initialize-escrow').addEventListener('click', () => {
            clearSandboxTimers();
            extensionsLoggedCount = 0;
            
            // Sync form configurations
            sandboxTargetName = dealNameInput.value;
            sandboxTargetAmt = parseFloat(dealAmountInput.value) || 2500;
            categoryAssignedName = mappedConfigResult.resolvedLabel;
            sandboxPaymentDelay = parseInt(payoutDelaySelect.value);

            document.getElementById('scen-disp-amount').innerText = `$${sandboxTargetAmt.toFixed(2)}`;
            
            selectTab('sandbox');
            updateSandboxState(LIFECYCLE_STATES.INITIALIZATION, 'API_INITIALIZATION_SUCCESS');
            addSandboxLog(`Contract registered! Mapped Category: ${categoryAssignedName}`, 'api');
        });

        // 1. BUYER CLEAR DEPOSIT Webhook
        eventButtons.deposit.addEventListener('click', () => {
            clearSandboxTimers();
            updateSandboxState(LIFECYCLE_STATES.PRE_FULFILLMENT, 'BUYER_DEPOSIT_CLEARED_WEBHOOK');
            addSandboxLog("Ledger command: lock_funds_nodal applied.", 'system');

            // Set Delivery timer
            sandboxTimeLeft = mappedConfigResult.tr_delivery;
            timerBadges.delivery.classList.remove('hidden');
            addSandboxLog(`TR_DELIVERY countdown initiated (${sandboxTimeLeft}s)`, 'timer');

            activeSandboxTimer = setInterval(() => {
                sandboxTimeLeft--;
                countdowns.delivery.innerText = `${sandboxTimeLeft}s remaining`;
                if (sandboxTimeLeft <= 0) {
                    clearSandboxTimers();
                    addSandboxLog("Timer Limit Exceeded: TR_DELIVERY timeout reached.", 'error');
                    executeSimulatorCancellation();
                }
            }, 1000);
        });

        // 2. LOGISTICS HANDSHAKE OTP Webhook
        eventButtons.courier.addEventListener('click', () => {
            clearSandboxTimers();
            updateSandboxState(LIFECYCLE_STATES.POST_FULFILLMENT, 'LOGISTICS_DELIVERY_CONFIRMED');

            // Set Inspection timer
            sandboxTimeLeft = mappedConfigResult.tr_inspection;
            timerBadges.inspection.classList.remove('hidden');
            addSandboxLog(`TR_INSPECTION countdown initiated (${sandboxTimeLeft}s)`, 'timer');

            activeSandboxTimer = setInterval(() => {
                sandboxTimeLeft--;
                countdowns.inspection.innerText = `${sandboxTimeLeft}s remaining`;
                if (sandboxTimeLeft <= 0) {
                    clearSandboxTimers();
                    addSandboxLog("Inspection window closed silently. Defaulting to payout routing.", 'timer');
                    executeSimulatorSettlement();
                }
            }, 1000);
        });

        // 3. FORCE DELIVERY TIMEOUT Webhook
        eventButtons.timeout.addEventListener('click', () => {
            clearSandboxTimers();
            addSandboxLog("Developer action: Trigger Timeout Forced Revert.", 'error');
            executeSimulatorCancellation();
        });

        // 4. BUYER EXPLICIT APPROVE release
        eventButtons.approve.addEventListener('click', () => {
            if (currentSandboxState === LIFECYCLE_STATES.SETTLED) {
                addSandboxLog("Buyer bypasses pending hold: Forcing direct clearing.", 'api');
                finalizeSimulatorSettlement();
            } else {
                clearSandboxTimers();
                addSandboxLog("Buyer approved verification checklist.", 'success');
                executeSimulatorSettlement();
            }
        });

        // 5. BUYER EXPLICIT REJECTION
        eventButtons.reject.addEventListener('click', () => {
            if (currentSandboxState === LIFECYCLE_STATES.SETTLED) {
                // Intercept pending cooling loop to trigger late dispute
                clearSandboxTimers();
                addSandboxLog("Conflict registered! Intercepted active payment delay countdown.", 'error');
                updateSandboxState(LIFECYCLE_STATES.DISPUTE_TRIAGE, 'LATE_STAGE_DISPUTE_INTERCEPT');
            } else {
                // Inspection rejection transitions to the state 04 reconciliation sandbox
                clearSandboxTimers();
                updateSandboxState(LIFECYCLE_STATES.REJECTION_RECONCILIATION, 'BUYER_REJECTION_INITIALIZED');

                // Trigger Rejection countdown
                sandboxTimeLeft = mappedConfigResult.tr_rejection;
                timerBadges.rejection.classList.remove('hidden');
                addSandboxLog(`TR_REJECTION countdown initiated (${sandboxTimeLeft}s)`, 'timer');

                activeSandboxTimer = setInterval(() => {
                    sandboxTimeLeft--;
                    countdowns.rejection.innerText = `${sandboxTimeLeft}s remaining`;
                    if (sandboxTimeLeft <= 0) {
                        clearSandboxTimers();
                        addSandboxLog("TR_REJECTION timeout reached without resolutions. Auto-escalating.", 'error');
                        updateSandboxState(LIFECYCLE_STATES.DISPUTE_TRIAGE, 'REJECTION_TIMER_EXPIRED');
                    }
                }, 1000);
            }
        });

        // 6. RECONCILIATION CHANNELS: Accept offer
        eventButtons.recAccept.addEventListener('click', () => {
            clearSandboxTimers();
            addSandboxLog("Counterparties agreed on settlement offer.", 'reconcile');
            executeSimulatorSettlement();
        });

        // 7. RECONCILIATION CHANNELS: Extend timer
        eventButtons.recExtend.addEventListener('click', () => {
            if (extensionsLoggedCount < 2) {
                extensionsLoggedCount++;
                sandboxTimeLeft += 5; // Simulates extending window limits
                addSandboxLog(`Buyer policy extension: Added +5s to clock limit (Extensions: ${extensionsLoggedCount}/2)`, 'reconcile');
                countdowns.rejection.innerText = `${sandboxTimeLeft}s remaining`;
                
                if (extensionsLoggedCount >= 2) {
                    eventButtons.recExtend.disabled = true;
                    eventButtons.recExtend.classList.add('opacity-50', 'cursor-not-allowed');
                    document.getElementById('lbl-scen-extend').innerText = "Max Extensions Used";
                }
                updateOutboundPayloadJson();
            }
        });

        // 8. RECONCILIATION CHANNELS: Escalate
        eventButtons.recEscalate.addEventListener('click', () => {
            clearSandboxTimers();
            addSandboxLog("Negotiation stalled. Escalating directly to formal dispute.", 'error');
            updateSandboxState(LIFECYCLE_STATES.DISPUTE_TRIAGE, 'BUYER_REJECTED_RESOLUTION_COMMUNICATIONS');
        });

        // 9. RESOLVE DISPUTE Arbitrated Resolution
        eventButtons.disputeResolve.addEventListener('click', () => {
            clearSandboxTimers();
            addSandboxLog("Arbitrator issued final legal determination.", 'success');
            executeSimulatorSettlement();
        });

        // PROCESS CONTROLLERS
        function executeSimulatorCancellation() {
            clearSandboxTimers();
            updateSandboxState(LIFECYCLE_STATES.AUTO_CANCELLED, 'REVERT_100_PERCENT_TO_BUYER');
            addSandboxLog("Settlement payload executed. Trust reverted to customer ledger.", 'success');
        }

        function executeSimulatorSettlement() {
            clearSandboxTimers();
            
            if (sandboxPaymentDelay > 0) {
                addSandboxLog(`TR_PAYMENT cooling countdown activated (${sandboxPaymentDelay}s delay)`, 'timer');
                updateSandboxState(LIFECYCLE_STATES.SETTLED, 'PAYMENT_COOLING_ACTIVE');

                // Adjust Settled UI node parameters for cooling countdown visual indication
                document.getElementById('settled-scen-badge').innerText = "COOLING HOLD";
                document.getElementById('settled-scen-badge').className = "text-[9px] bg-brandAmber/20 text-brandAmber border border-brandAmber/30 px-1.5 py-0.5 rounded font-mono font-semibold";
                document.getElementById('settled-scen-title').innerText = "RELEASE PENDING";
                document.getElementById('settled-scen-desc').innerText = "Lien hold active. Awaiting cooling countdown to clear.";
                document.getElementById('settled-scen-status').innerText = "RELEASING TO WALLET...";
                document.getElementById('settled-scen-status').className = "text-brandAmber font-bold animate-pulse uppercase";

                countdowns.payment.classList.remove('hidden');
                sandboxTimeLeft = sandboxPaymentDelay;
                countdowns.payment.innerText = `${sandboxTimeLeft}s`;

                activeSandboxTimer = setInterval(() => {
                    sandboxTimeLeft--;
                    countdowns.payment.innerText = `${sandboxTimeLeft}s remaining`;
                    if (sandboxTimeLeft <= 0) {
                        finalizeSimulatorSettlement();
                    }
                }, 1000);
            } else {
                addSandboxLog("TR_PAYMENT delay omitted (0s configuration). Instant settlement.", 'timer');
                finalizeSimulatorSettlement();
            }
        }

        function finalizeSimulatorSettlement() {
            clearSandboxTimers();
            addSandboxLog("Ledger payment cleared.", 'success');
            
            // Restore Settled node UI values
            document.getElementById('settled-scen-badge').innerText = "SETTLED IN WALLET";
            document.getElementById('settled-scen-badge').className = "text-[9px] bg-brandEmerald/20 text-brandEmerald border border-brandEmerald/30 px-1.5 py-0.5 rounded font-mono font-semibold";
            document.getElementById('settled-scen-title').innerText = "PROPRIETARY ESCROW WALLET";
            document.getElementById('settled-scen-desc').innerText = "Funds successfully cleared to verified merchant node.";
            document.getElementById('settled-scen-status').innerText = "LEDGER UNLOCKED";
            document.getElementById('settled-scen-status').className = "text-brandEmerald font-bold tracking-wider uppercase";

            updateSandboxState(LIFECYCLE_STATES.SETTLED, 'FUNDS_RELEASED_TO_ESCROW_WALLET');
        }

        // INTEGRATED SCENARIO AUTO-RUN PATHS
        
        // Scenario A: Happy path
        document.getElementById('scen-btn-happy').addEventListener('click', () => {
            triggerToast("Running Scenario A", "Automated sequence: Happy path initialized.", "🟢");
            clearSandboxTimers();
            extensionsLoggedCount = 0;
            sandboxPaymentDelay = 5;
            
            updateSandboxState(LIFECYCLE_STATES.INITIALIZATION, 'SCENARIO_HAPPY_START');
            
            // Sequence of automated triggers
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.INITIALIZATION) eventButtons.deposit.click(); }, 1200);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.PRE_FULFILLMENT) eventButtons.courier.click(); }, 2800);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.POST_FULFILLMENT) eventButtons.approve.click(); }, 4500);
        });

        // Scenario B: Delivery timeout
        document.getElementById('scen-btn-del-timeout').addEventListener('click', () => {
            triggerToast("Running Scenario B", "Automated sequence: Delivery failure tracking.", "🔴");
            clearSandboxTimers();
            extensionsLoggedCount = 0;
            
            updateSandboxState(LIFECYCLE_STATES.INITIALIZATION, 'SCENARIO_TIMEOUT_START');
            
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.INITIALIZATION) eventButtons.deposit.click(); }, 1200);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.PRE_FULFILLMENT) eventButtons.timeout.click(); }, 3500);
        });

        // Scenario C: Rejection reconciliation
        document.getElementById('scen-btn-reconcile').addEventListener('click', () => {
            triggerToast("Running Scenario C", "Automated sequence: Rejection & Extension.", "🟣");
            clearSandboxTimers();
            extensionsLoggedCount = 0;
            
            updateSandboxState(LIFECYCLE_STATES.INITIALIZATION, 'SCENARIO_RECONCILE_START');
            
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.INITIALIZATION) eventButtons.deposit.click(); }, 1000);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.PRE_FULFILLMENT) eventButtons.courier.click(); }, 2200);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.POST_FULFILLMENT) eventButtons.reject.click(); }, 3500);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.REJECTION_RECONCILIATION) eventButtons.recExtend.click(); }, 5000);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.REJECTION_RECONCILIATION) eventButtons.recAccept.click(); }, 6800);
        });

        // Scenario D: Cooling Period Dispute Intercept
        document.getElementById('scen-btn-cooling-dispute').addEventListener('click', () => {
            triggerToast("Running Scenario D", "Automated sequence: Cooling hold dispute.", "🟡");
            clearSandboxTimers();
            extensionsLoggedCount = 0;
            sandboxPaymentDelay = 12; // Longer hold to permit easier manual click
            payoutDelaySelect.value = "12";
            
            updateSandboxState(LIFECYCLE_STATES.INITIALIZATION, 'SCENARIO_INTERCEPT_START');
            
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.INITIALIZATION) eventButtons.deposit.click(); }, 1000);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.PRE_FULFILLMENT) eventButtons.courier.click(); }, 2200);
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.POST_FULFILLMENT) eventButtons.approve.click(); }, 3500);
            // Wait 2.5 seconds during the 12s cooling loop to automatically trigger dispute override
            setTimeout(() => { if (currentSandboxState === LIFECYCLE_STATES.SETTLED) eventButtons.reject.click(); }, 6000);
        });

        // Window load initialization default logs
        window.onload = function() {
            addSandboxLog("Sandbox system ready. Node registers established.", 'system');
            addSandboxLog("Config standard headers: Bearer tokens loaded.", 'system');
        }
    </script>
</body>
</html>
