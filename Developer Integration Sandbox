<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TrustedPayer V3 - Developer Integration Sandbox</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Inter Font and Fira Code for code styling -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        mono: ['Fira Code', 'monospace'],
                    },
                    colors: {
                        devDarkBg: '#090D16',
                        devCardBg: '#111827',
                        devCodeBg: '#1F2937',
                        devBorder: '#374151',
                        brandBlue: '#3B82F6',
                        brandEmerald: '#10B981',
                        brandAmber: '#F59E0B',
                        brandRose: '#F43F5E',
                        brandViolet: '#8B5CF6',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #090D16;
            color: #F3F4F6;
        }
        /* Scrollbars for Console and Code blocks */
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #090D16;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 3px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #3B82F6;
        }
    </style>
</head>
<body class="selection:bg-brandBlue selection:text-white antialiased">

    <!-- DEVELOPER PORTAL NAVBAR -->
    <header class="border-b border-devBorder bg-devDarkBg/90 backdrop-blur-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-9 h-9 bg-gradient-to-tr from-brandBlue to-brandViolet rounded-lg flex items-center justify-center text-white font-extrabold text-base shadow-lg shadow-brandViolet/20">
                    TP
                </div>
                <div>
                    <h1 class="text-base font-bold tracking-tight text-white uppercase flex items-center gap-2">
                        TrustedPayer <span class="text-xs bg-slate-800 text-brandBlue border border-devBorder px-2 py-0.5 rounded font-mono normal-case">V3 DevHub</span>
                    </h1>
                    <p class="text-[11px] text-gray-400">Merchant API & Transaction Sandbox</p>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-brandEmerald/10 text-brandEmerald border border-brandEmerald/20">
                    <span class="w-1.5 h-1.5 bg-brandEmerald rounded-full mr-1.5 animate-pulse"></span> Sandbox API Active
                </span>
                <span class="text-[11px] text-gray-500 font-mono hidden md:inline">SDK_REF_v3.2.1</span>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
        
        <!-- INTRO HERO BLOCK -->
        <div class="bg-gradient-to-r from-devCardBg to-[#111C35] border border-devBorder rounded-2xl p-6 sm:p-8 relative overflow-hidden">
            <div class="absolute -right-8 -top-8 text-8xl text-devBorder/20 font-mono font-bold select-none pointer-events-none">SDK</div>
            <div class="relative z-10 max-w-4xl space-y-3">
                <div class="text-xs font-mono text-brandViolet uppercase tracking-wider font-bold">MERCHANT INTEGRATION FRAMEWORK</div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Dynamic Escrow Routing & Category Mapping Engine</h2>
                <p class="text-gray-300 text-sm leading-relaxed">
                    Welcome to the TrustedPayer Partner Sandbox. This environment lets you simulate how an integrating marketplace (e.g., your e-commerce platform or B2B directory) configures metadata, resolves category timer mismatches, and pushes live, event-driven state transitions to our ledger system. Use the tabs below to configure mappings, initiate dynamic checkout flows, and test all automated timing boundaries.
                </p>
            </div>
        </div>

        <!-- TAB CONTAINER -->
        <div class="border-b border-devBorder flex flex-wrap gap-2 text-sm">
            <button id="tab-btn-map" class="px-4 py-2 border-b-2 border-brandBlue text-white font-medium focus:outline-none transition-all duration-150">
                1. Category Mapping Engine
            </button>
            <button id="tab-btn-checkout" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-white font-medium focus:outline-none transition-all duration-150">
                2. Marketplace Checkout API
            </button>
            <button id="tab-btn-sandbox" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-white font-medium focus:outline-none transition-all duration-150">
                3. Lifecycle Sandbox Simulation
            </button>
            <button id="tab-btn-docs" class="px-4 py-2 border-b-2 border-transparent text-gray-400 hover:text-white font-medium focus:outline-none transition-all duration-150">
                4. API Documentation
            </button>
        </div>

        <!-- CUSTOM NOTIFICATION TOAST -->
        <div id="toast-notification" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 border border-brandBlue p-4 rounded-xl shadow-2xl flex items-start gap-3 max-w-sm pointer-events-none">
            <span class="text-xl shrink-0" id="toast-icon">⚡</span>
            <div>
                <p class="text-xs font-bold text-white uppercase tracking-wider" id="toast-title">API NOTIFICATION</p>
                <p class="text-xs text-gray-300 mt-1" id="toast-message">Action executed successfully.</p>
            </div>
        </div>

        <!-- TAB SECTION 1: CATEGORY MAPPING ENGINE -->
        <section id="tab-section-map" class="space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Left Details: Explanation of choice -->
                <div class="lg:col-span-1 space-y-4">
                    <h3 class="text-xl font-bold text-white flex items-center gap-2">
                        <span>🏷️</span> Dynamic Semantic Category Mapping
                    </h3>
                    <p class="text-xs text-gray-400 leading-relaxed">
                        To enforce strict risk limits, the TrustedPayer core engine operates on four global parent categories with hardcoded timer configurations. When you integrate a third-party marketplace, their local categories will frequently fail to match our database.
                    </p>
                    
                    <div class="bg-devCardBg border border-devBorder p-4 rounded-xl space-y-3">
                        <h4 class="text-xs font-bold text-brandViolet uppercase tracking-wider">Our Architectural Solution</h4>
                        <p class="text-[11px] text-gray-300 leading-relaxed">
                            Rather than dumping unmatched categories into a default "General" category (which distorts risk tracking and violates our AML profile guarantees), TrustedPayer employs a <strong>Hybrid Semantic String Distance Mapping</strong> model. 
                        </p>
                        <p class="text-[11px] text-gray-300 leading-relaxed">
                            Upon receiving a contract initialization request, our API pipeline checks if the category exists. If unmatched, it runs a semantic string heuristic lookup against global parents. If the confidence matches above 70%, it automatically instantiates a new virtual mapped category label inheriting the correct parental properties. If it fails the threshold, it falls back to a standardized high-level ancestor framework.
                        </p>
                    </div>

                    <div class="bg-slate-950 p-3.5 rounded-lg border border-devBorder/60 space-y-2">
                        <span class="text-[10px] text-gray-400 block uppercase font-bold">Inherited Global Timers</span>
                        <div class="grid grid-cols-2 gap-2 text-[10px] font-mono">
                            <div class="bg-devDarkBg p-2 rounded border border-devBorder/40">
                                <span class="text-brandBlue block">TR_DELIVERY</span>
                                <span class="font-bold text-white">Physical: 15s</span>
                            </div>
                            <div class="bg-devDarkBg p-2 rounded border border-devBorder/40">
                                <span class="text-brandViolet block">TR_INSPECTION</span>
                                <span class="font-bold text-white">Service: 20s</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Interactive Mapping Panel -->
                <div class="lg:col-span-2 bg-devCardBg border border-devBorder rounded-2xl p-6 space-y-6">
                    <div>
                        <h4 class="text-sm font-bold text-white">Interactive Mapping Console</h4>
                        <p class="text-xs text-gray-400 mt-1">Simulate sending standard and non-standard custom category strings. Observe how the endpoint routes them to appropriate timer bounds.</p>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold text-gray-400 uppercase mb-2">Select or Enter Category String to Resolve</label>
                            <div class="flex gap-2">
                                <select id="category-selector-api" class="flex-grow bg-devDarkBg border border-devBorder rounded-lg px-3 py-2 text-xs text-white focus:outline-none focus:border-brandBlue">
                                    <option value="Physical Retail Goods">Physical Retail Goods (Standard Parent)</option>
                                    <option value="Professional Digital Services">Professional Digital Services (Standard Parent)</option>
                                    <option value="High-Value Exotic Antiques">High-Value Exotic Antiques (Custom Unmatched - Expect string distance mapping)</option>
                                    <option value="Freelance Python Programming">Freelance Python Programming (Custom Unmatched - Expect digital parent mapping)</option>
                                    <option value="Unregistered Unknown Token">Unregistered Unknown Token (Custom Unmatched - Fallback routine triggered)</option>
                                </select>
                                <button id="btn-resolve-mapping" class="bg-brandBlue hover:bg-brandBlue/90 text-white text-xs font-semibold px-4 py-2 rounded-lg transition">
                                    Resolve Mapping
                                </button>
                            </div>
                        </div>

                        <!-- Mapping Result Output View -->
                        <div class="bg-devDarkBg border border-devBorder rounded-xl p-4 space-y-3 relative">
                            <div class="flex justify-between items-center border-b border-devBorder pb-2">
                                <span class="text-[10px] font-mono text-gray-400">RESOLVED SCHEMATIC OUTCOME</span>
                                <span id="mapping-badge-status" class="px-2 py-0.5 rounded text-[9px] font-mono bg-brandBlue/20 text-brandBlue border border-brandBlue/30">PENDING_EVAL</span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs py-1">
                                <div>
                                    <span class="text-[9px] uppercase text-gray-500 block">Assigned Parent Category</span>
                                    <span id="map-out-parent" class="font-bold text-white">-</span>
                                </div>
                                <div>
                                    <span class="text-[9px] uppercase text-gray-500 block">Mapping Strategy Employed</span>
                                    <span id="map-out-strategy" class="font-mono text-brandViolet font-semibold">-</span>
                                </div>
                                <div>
                                    <span class="text-[9px] uppercase text-gray-500 block">Target Timer Rules</span>
                                    <span id="map-out-timers" class="font-mono text-brandEmerald font-semibold">-</span>
                                </div>
                            </div>

                            <div class="bg-[#1e293b]/30 p-3 rounded-lg border border-devBorder/30 space-y-2">
                                <p class="text-[10px] text-gray-300 italic" id="map-out-text">Select a category and trigger Resolve Mapping to view automated routing behavior.</p>
                            </div>
                        </div>

                        <div class="text-right">
                            <button id="btn-proceed-to-checkout" class="bg-gradient-to-r from-brandBlue to-brandViolet hover:opacity-90 text-white text-xs font-bold px-5 py-2.5 rounded-xl transition shadow-lg shadow-brandBlue/10">
                                Apply Mapping & Proceed to Checkout ➔
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- TAB SECTION 2: MARKETPLACE CHECKOUT -->
        <section id="tab-section-checkout" class="hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Left: Simulated NexaMarket Storefront Checkout Panel -->
                <div class="lg:col-span-2 bg-devCardBg border border-devBorder rounded-2xl p-6 space-y-6">
                    <div class="border-b border-devBorder pb-4 flex justify-between items-center">
                        <div>
                            <span class="text-[10px] font-bold text-brandViolet uppercase tracking-wider">SIMULATED STOREFRONT</span>
                            <h3 class="text-lg font-bold text-white">NexaMarket Checkout Gateway</h3>
                        </div>
                        <span class="text-xs bg-brandViolet/10 text-brandViolet border border-brandViolet/20 px-2.5 py-1 rounded font-mono font-semibold">Integrator Sandbox</span>
                    </div>

                    <!-- Checkout Form -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                        <div>
                            <label class="block text-gray-400 font-bold mb-1">Contract / Deal Item Name</label>
                            <input id="checkout-deal-name" type="text" value="Enterprise Database Server Node V10" class="w-full bg-devDarkBg border border-devBorder rounded-lg px-3 py-2 text-white focus:outline-none focus:border-brandBlue">
                        </div>
                        <div>
                            <label class="block text-gray-400 font-bold mb-1">Payment Amount (USD)</label>
                            <input id="checkout-amount" type="number" value="2500" class="w-full bg-devDarkBg border border-devBorder rounded-lg px-3 py-2 text-white focus:outline-none focus:border-brandBlue">
                        </div>
                        <div>
                            <label class="block text-gray-400 font-bold mb-1">Local Marketplace Category</label>
                            <input id="checkout-category-input" type="text" value="Physical Retail Goods" class="w-full bg-devDarkBg border border-devBorder rounded-lg px-3 py-2 text-white bg-opacity-50 cursor-not-allowed" readonly>
                            <p class="text-[9px] text-slate-500 mt-1 italic">Inherited from the mapping parameters set in Step 1.</p>
                        </div>
                        <div>
                            <label class="block text-gray-400 font-bold mb-1">Seller Custom Payout Delay (TR_PAYMENT)</label>
                            <select id="checkout-payment-delay" class="w-full bg-devDarkBg border border-devBorder rounded-lg px-3 py-2 text-white focus:outline-none focus:border-brandBlue">
                                <option value="5">5 Seconds (Short Cooling Period)</option>
                                <option value="12">12 Seconds (Moderate Cooling Period)</option>
                                <option value="0">0 Seconds (Instant Settle on Approval)</option>
                            </select>
                        </div>
                    </div>

                    <div class="bg-devDarkBg border border-devBorder rounded-xl p-4 space-y-3">
                        <div class="flex items-center gap-2">
                            <span class="text-brandBlue text-sm">🔒</span>
                            <span class="text-xs font-bold text-gray-300">TrustedPayer Automated Routing Compliance</span>
                        </div>
                        <p class="text-[10.5px] text-gray-400 leading-relaxed">
                            Upon checkout completion, NexaMarket will query our core API, dispatching this transaction profile. The funds are held in secure nodal accounts with a temporary lien assigned, preventing intermediate leakage.
                        </p>
                    </div>

                    <div class="flex justify-between items-center pt-2">
                        <button id="btn-back-to-mapping" class="text-xs text-gray-400 hover:text-white transition">➔ Reconfigure Category Mapping</button>
                        <button id="btn-initialize-escrow" class="bg-brandBlue hover:bg-brandBlue/90 text-white text-xs font-bold px-6 py-2.5 rounded-xl transition shadow-lg shadow-brandBlue/20 flex items-center gap-2">
                            <span>🔌</span> Initialize Escrow Transaction
                        </button>
                    </div>
                </div>

                <!-- Right: Auto-compiled Request payload JSON payload -->
                <div class="lg:col-span-1 flex flex-col justify-between bg-devCardBg border border-devBorder rounded-2xl p-6 min-h-[400px]">
                    <div class="border-b border-devBorder pb-3 flex justify-between items-center">
                        <span class="text-xs font-mono font-bold text-gray-300">COMPILING INITIALIZE API REQUEST</span>
                        <span class="w-2 h-2 rounded-full bg-brandBlue animate-pulse"></span>
                    </div>

                    <div class="flex-grow bg-devDarkBg/80 rounded-xl p-3 my-4 border border-devBorder/80 font-mono text-[10px] text-gray-300 overflow-x-auto select-all custom-scrollbar max-h-[320px]">
                        <pre id="api-request-json">
{
  "contract_name": "Enterprise Database Server Node V10",
  "category": "Physical Retail Goods",
  "fiat_amount": 2500,
  "client_id": "cli_nexa_market_prod_2026",
  "seller_configs": {
    "tr_payment_hold_seconds": 5
  }
}
                        </pre>
                    </div>
                    
                    <div class="text-[9.5px] text-gray-400 italic text-right">
                        *Generated based on input storefront variables.
                    </div>
                </div>

            </div>
        </section>

        <!-- TAB SECTION 3: LIFECYCLE SANDBOX SIMULATION -->
        <section id="tab-section-sandbox" class="hidden space-y-6">
            
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                
                <!-- Main Lifecycle Status, State Graph Interface -->
                <div class="xl:col-span-2 space-y-6">
                    
                    <!-- DYNAMIC SCENARIO CONTROL CARD -->
                    <div class="bg-devCardBg border border-devBorder rounded-2xl p-5 space-y-3">
                        <div class="flex items-center justify-between border-b border-devBorder pb-2">
                            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">SIMULATOR STATE CONTROLS</span>
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-slate-500 font-mono">Current State:</span>
                                <span id="simulation-state-tag" class="px-2 py-0.5 rounded text-[10px] font-mono bg-slate-800 text-gray-400 border border-devBorder">UNINITIALIZED</span>
                            </div>
                        </div>

                        <!-- Scenarios Quick Injectors buttons -->
                        <div>
                            <p class="text-[11px] text-slate-400 font-bold uppercase mb-2">Inject Scenario Quick-Paths</p>
                            <div class="flex flex-wrap gap-2 text-xs">
                                <button id="scen-btn-happy" class="px-3 py-1.5 rounded-lg bg-brandEmerald/10 text-brandEmerald border border-brandEmerald/20 hover:bg-brandEmerald/20 transition">Scenario A: Happy Path</button>
                                <button id="scen-btn-del-timeout" class="px-3 py-1.5 rounded-lg bg-brandRose/10 text-brandRose border border-brandRose/20 hover:bg-brandRose/20 transition">Scenario B: Delivery Failure</button>
                                <button id="scen-btn-reconcile" class="px-3 py-1.5 rounded-lg bg-brandViolet/10 text-brandViolet border border-brandViolet/20 hover:bg-brandViolet/20 transition">Scenario C: Rejection Resolve</button>
                                <button id="scen-btn-cooling-dispute" class="px-3 py-1.5 rounded-lg bg-brandAmber/10 text-brandAmber border border-brandAmber/20 hover:bg-brandAmber/20 transition">Scenario D: Cooling Period Intercept</button>
                            </div>
                        </div>
                    </div>

                    <!-- Flowchart Grid (Dynamic Canvas representing Sandbox) -->
                    <div class="bg-devCardBg border border-devBorder rounded-2xl p-6 relative overflow-hidden flex flex-col justify-between min-h-[420px]">
                        
                        <div class="flex items-center justify-between mb-4 border-b border-devBorder pb-3">
                            <span class="text-xs font-mono text-gray-400">STATE TRANSITION CANVAS</span>
                            <div class="flex flex-wrap items-center gap-3 text-[10px]">
                                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-brandBlue inline-block"></span> Active</span>
                                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-brandViolet inline-block"></span> Reconciling</span>
                                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-brandAmber inline-block"></span> Cooling Delay</span>
                                <span class="flex items-center gap-1.5"><span class="w-2 h-2 rounded bg-brandEmerald inline-block"></span> Settled Node</span>
                            </div>
                        </div>

                        <!-- Canvas Diagram Container -->
                        <div class="flex-grow grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 items-center justify-center py-4 relative">
                            
                            <!-- State 1: Initialization -->
                            <div id="scen-state-01" class="border border-devBorder bg-devDarkBg/50 p-3.5 rounded-xl flex flex-col justify-between h-34 transition-all duration-300">
                                <div class="flex justify-between items-start">
                                    <span class="text-[9px] font-mono text-gray-500">STATE 01</span>
                                    <span class="text-[9px] bg-slate-800 text-gray-400 px-1.5 py-0.5 rounded font-mono">INITIAL</span>
                                </div>
                                <h4 class="font-bold text-[11px] text-white mt-2">INITIALIZATION</h4>
                                <p class="text-[9.5px] text-gray-400 leading-snug">Contracts initiated & mapped. Escrow clearing.</p>
                                <div class="mt-2 text-[10px] font-semibold text-brandBlue flex justify-between items-center">
                                    <span>Escrow Funds</span>
                                    <span id="scen-disp-amount">$0.00</span>
                                </div>
                            </div>

                            <!-- State 2: Pre-Fulfillment -->
                            <div id="scen-state-02" class="border border-devBorder bg-devDarkBg/50 p-3.5 rounded-xl flex flex-col justify-between h-34 transition-all duration-300">
                                <div class="flex justify-between items-start">
                                    <span class="text-[9px] font-mono text-gray-500">STATE 02</span>
                                    <span id="badge-scen-delivery" class="text-[9px] bg-brandAmber/20 text-brandAmber border border-brandAmber/30 px-1.5 py-0.5 rounded font-mono hidden font-semibold">TR_DELIVERY</span>
                                </div>
                                <h4 class="font-bold text-[11px] text-white mt-2">PRE-FULFILLMENT</h4>
                                <p class="text-[9.5px] text-gray-400 leading-snug">Escrow funded. Awaiting shipping logistics logs.</p>
                                <div class="mt-2 text-[10px] flex justify-between items-center">
                                    <span class="text-[9px] text-gray-500">Delivery Clock</span>
                                    <span id="timer-scen-delivery" class="font-mono text-brandAmber font-bold">-</span>
                                </div>
                            </div>

                            <!-- State 3: Post-Fulfillment -->
                            <div id="scen-state-03" class="border border-devBorder bg-devDarkBg/50 p-3.5 rounded-xl flex flex-col justify-between h-34 transition-all duration-300">
                                <div class="flex justify-between items-start">
                                    <span class="text-[9px] font-mono text-gray-500">STATE 03</span>
                                    <span id="badge-scen-inspection" class="text-[9px] bg-brandBlue/20 text-brandBlue border border-brandBlue/30 px-1.5 py-0.5 rounded font-mono hidden font-semibold">TR_INSPECTION</span>
                                </div>
                                <h4 class="font-bold text-[11px] text-white mt-2">POST-FULFILLMENT</h4>
                                <p class="text-[9.5px] text-gray-400 leading-snug">Delivery cleared. Active inspection constraints.</p>
                                <div class="mt-2 text-[10px] flex justify-between items-center">
                                    <span class="text-[9px] text-gray-500">Inspect Clock</span>
                                    <span id="timer-scen-inspection" class="font-mono text-brandBlue font-bold">-</span>
                                </div>
                            </div>

                            <!-- State 4: Rejection Reconciliation -->
                            <div id="scen-state-04" class="border border-devBorder bg-devDarkBg/50 p-3.5 rounded-xl flex flex-col justify-between h-34 transition-all duration-300">
                                <div class="flex justify-between items-start">
                                    <span class="text-[9px] font-mono text-gray-500">STATE 04</span>
                                    <span id="badge-scen-rejection" class="text-[9px] bg-brandViolet/20 text-brandViolet border border-brandViolet/30 px-1.5 py-0.5 rounded font-mono hidden font-semibold">TR_REJECTION</span>
                                </div>
                                <h4 class="font-bold text-[11px] text-white mt-2">RECONCILIATION</h4>
                                <p class="text-[9.5px] text-gray-400 leading-snug">Cargo rejected. Resolving via sandbox buffer.</p>
                                <div class="mt-2 text-[10px] flex justify-between items-center">
                                    <span class="text-[9px] text-gray-500">Reconcile Clock</span>
                                    <span id="timer-scen-rejection" class="font-mono text-brandViolet font-bold">-</span>
                                </div>
                            </div>

                            <!-- State 5: Dispute Triage -->
                            <div id="scen-state-05" class="border border-devBorder bg-devDarkBg/50 p-3.5 rounded-xl flex flex-col justify-between h-34 transition-all duration-300">
